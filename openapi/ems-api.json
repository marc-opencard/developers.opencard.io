          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookCreate"
              },
              "example": {
                "url": "https://your-app.com/hooks/opencard",
                "card_transaction_cleared": true,
                "card_transaction_authorized": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook created",
            "content": {
              "application/json": {
                "example": {
                  "id": 5,
                  "organization_id": 3,
                  "url": "https://your-app.com/hooks/opencard",
                  "active": true,
                  "enabled": true,
                  "card_transaction_authorized": true,
                  "card_transaction_cleared": true,
                  "card_transaction_deleted": true,
                  "receipt_fetched": true
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "webhooks-write"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/organizations/{organizationId}/webhooks/{webhookId}/events": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Delivery log",
        "operationId": "listWebhookEvents",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "$ref": "#/components/parameters/organizationId"
          },
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "description": "Webhook ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "event": "card.transaction.authorized",
                      "status": 200
                    }
                  ],
                  "per_page": 15,
                  "total": 1,
                  "last_page": 1
                }
              }
            }
