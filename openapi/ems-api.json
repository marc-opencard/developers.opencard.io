        ],
        "summary": "Create card holder",
        "operationId": "createCardHolder",
        "description": "Path A: `email` \u2192 PDPC email + eID. Path B: `identity_id` \u2192 instant, transactions flow immediately.",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "$ref": "#/components/parameters/organizationId"
