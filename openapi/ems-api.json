              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "id": 15,
                      "reference_id": "employee_john_42",
                      "organization_id": 3,
                      "meta": {
                        "signed": false,
                        "pdpc_url": "https://sandbox-api.opencard.io/accounts/1/pdpcs/8/sign/abc...",
