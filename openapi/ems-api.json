{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenCard EMS API",
    "version": "1.0",
    "description": "API for Expense Management Systems. Manage TPAs, organizations, card holders, and webhooks. Receive transaction data via webhooks \u2014 not by polling this API.",
    "contact": {
      "email": "support@opencard.io"
    }
  },
  "servers": [
    {
      "url": "https://api.opencard.io/api/v1/application",
      "description": "Production"
    },
    {
      "url": "https://sandbox-api.opencard.io/api/v1/application",
      "description": "Sandbox"
    }
  ],
  "paths": {
    "/accounts/{accountId}": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get your account",
        "operationId": "getAccount",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name_system": "Acme EMS",
                  "name_legal": "Acme Expense AB",
                  "organization_number": "5561234567",
                  "country": "SE"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "example": {
                  "error": "Access denied"
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "accounts-read"
            ]
          }
        ]
      },
      "put": {
        "tags": [
          "Account"
        ],
        "summary": "Update your account",
        "operationId": "updateAccount",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notify_email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated account",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name_system": "Acme EMS",
                  "name_legal": "Acme Expense AB",
                  "organization_number": "5561234567",
                  "country": "SE"
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "accounts-write"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/oauthclients": {
      "get": {
        "tags": [
          "OAuth Clients"
        ],
        "summary": "List OAuth clients",
        "operationId": "listOAuthClients",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "responses": {
          "200": {
            "description": "OAuth clients",
            "content": {
              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "id": 1,
                      "name": "Production EMS"
                    }
                  ],
                  "per_page": 15,
                  "total": 1,
                  "last_page": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "oauth-clients-read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "OAuth Clients"
        ],
        "summary": "Create OAuth client",
        "operationId": "createOAuthClient",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "example": {
                  "id": 2,
                  "secret": "plain-text-secret-shown-once"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "example": {
                  "error": "Access denied"
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "oauth-clients-write"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/publicrecords": {
      "get": {
        "tags": [
          "Public Records"
        ],
        "summary": "Lookup company + signing combinations",
        "operationId": "queryPublicRecords",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "SE",
                "DK",
                "NO",
                "FI"
              ]
            }
          },
          {
            "name": "organization_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public record",
            "content": {
              "application/json": {
                "example": {
                  "name": "Acme AB",
                  "signature_combinations": [
                    [
                      {
                        "name": "Anna Andersson"
                      }
                    ]
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "public-records-read"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/tpas": {
      "get": {
        "tags": [
          "TPAs"
        ],
        "summary": "List TPAs",
        "operationId": "listTpas",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "responses": {
          "200": {
            "description": "TPAs",
            "content": {
              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "id": 42,
                      "account_id": 1,
                      "card_issuer_id": 1,
                      "name": "Acme AB",
                      "country": "SE",
                      "organization_number": "5561234567",
                      "activated": false,
                      "signatures_verified": false,
                      "status": "pending-signatures"
                    }
                  ],
                  "per_page": 15,
                  "total": 1,
                  "last_page": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpas-read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "TPAs"
        ],
        "summary": "Create TPA",
        "operationId": "createTpa",
        "description": "Creates TPA, fetches registry data, generates legal text.",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TpaCreate"
              },
              "example": {
                "card_issuer_id": 1,
                "name": "Acme AB",
                "country": "SE",
                "organization_number": "5561234567",
                "language": "sv"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "TPA created",
            "content": {
              "application/json": {
                "example": {
                  "id": 42,
                  "account_id": 1,
                  "card_issuer_id": 1,
                  "name": "Acme AB",
                  "country": "SE",
                  "organization_number": "5561234567",
                  "activated": false,
                  "signatures_verified": false,
                  "status": "pending-signatures"
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpas-write"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/tpas/{tpaId}": {
      "get": {
        "tags": [
          "TPAs"
        ],
        "summary": "Get TPA",
        "operationId": "getTpa",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "tpaId",
            "in": "path",
            "required": true,
            "description": "TPA ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "TPA",
            "content": {
              "application/json": {
                "example": {
                  "id": 42,
                  "account_id": 1,
                  "card_issuer_id": 1,
                  "name": "Acme AB",
                  "country": "SE",
                  "organization_number": "5561234567",
                  "activated": false,
                  "signatures_verified": false,
                  "status": "pending-signatures"
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpas-read"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "TPAs"
        ],
        "summary": "Delete TPA",
        "operationId": "deleteTpa",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "tpaId",
            "in": "path",
            "required": true,
            "description": "TPA ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpas-delete"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/tpas/{tpaId}/signatories": {
      "get": {
        "tags": [
          "TPA Signatories"
        ],
        "summary": "List signatories",
        "operationId": "listTpaSignatories",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "tpaId",
            "in": "path",
            "required": true,
            "description": "TPA ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signatories",
            "content": {
              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "id": 7,
                      "email": "ceo@acme.se",
                      "name": "Anna Andersson",
                      "tpa_id": 42,
                      "signed": false,
                      "signed_at": null
                    }
                  ],
                  "per_page": 15,
                  "total": 1,
                  "last_page": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpa-signatories-read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "TPA Signatories"
        ],
        "summary": "Add signatory (sends email)",
        "operationId": "createTpaSignatory",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "tpaId",
            "in": "path",
            "required": true,
            "description": "TPA ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TpaSignatoryCreate"
              },
              "example": {
                "email": "ceo@acme.se",
                "name": "Anna Andersson"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signatory created",
            "content": {
              "application/json": {
                "example": {
                  "id": 7,
                  "email": "ceo@acme.se",
                  "name": "Anna Andersson",
                  "tpa_id": 42,
                  "signed": false,
                  "signed_at": null
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpa-signatories-write"
            ]
          }
        ]
      }
    },
    "/accounts/{accountId}/tpas/{tpaId}/identities": {
      "get": {
        "tags": [
          "Identities"
        ],
        "summary": "List identities on TPA",
        "operationId": "listTpaIdentities",
        "description": "Physical persons linked to this TPA. Use `id` as `identity_id` for instant card holder onboarding.",
        "parameters": [
          {
            "$ref": "#/components/parameters/accountId"
          },
          {
            "name": "tpaId",
            "in": "path",
            "required": true,
            "description": "TPA ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "is_card_holder",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Identities",
            "content": {
              "application/json": {
                "example": {
                  "current_page": 1,
                  "data": [
                    {
                      "id": 123,
                      "name": "Anna Andersson",
                      "employee_id": "001",
                      "cards": [
                        {
                          "id": 10,
                          "last_four": "1234",
                          "token": "ext-card-abc",
                          "type": "corporate"
                        }
                      ],
                      "card_holders": []
                    }
                  ],
                  "per_page": 15,
                  "total": 1,
                  "last_page": 1
                }
              }
            }
          }
        },
        "security": [
          {
            "opencard_auth": [
              "account-tpa-identities-read"
            ]
          }
        ]
      }
    },
