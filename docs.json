{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenCard",
  "description": "Build on OpenCard. Real-time card data, digital receipts, zero bullshit.",
  "colors": {
    "primary": "#C9A9A9",
    "light": "#E8D4D4",
    "dark": "#8B6B6B"
  },
  "fonts": {
    "family": "Montserrat",
    "weight": 500
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FAFAF9",
      "dark": "#121212"
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "favicon": "/favicon.png",
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get API Access",
      "href": "https://sandbox-api.opencard.io/register"
    }
  },
  "api": {
    "openapi": [
      "openapi/oauth.json",
      "openapi/ems-api.json",
      "openapi/receipts-api.json",
      "openapi/receipt-provider-callback.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "php"],
      "defaults": "all",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Start Here",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction/index",
              "introduction/welcome",
              "introduction/how-it-works",
              "introduction/environments",
              "introduction/glossary"
            ]
          },
          {
            "group": "First integration",
            "pages": [
              "getting-started/register",
              "getting-started/authentication",
              "getting-started/quickstart"
            ]
          }
        ]
      },
      {
        "tab": "EMS",
        "groups": [
          {
            "group": "Platform",
            "pages": [
              "ems/data-model",
              "ems/organizations",
              "ems/error-handling"
            ]
          },
          {
            "group": "Customer onboarding",
            "pages": [
              "ems/tpa-flow",
              "ems/eid-signing",
              "ems/card-holders",
              "ems/pdpc-flow"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "ems/webhooks/setup",
              "ems/webhooks/events",
              "ems/webhooks/transactions"
            ]
          },
          {
            "group": "Enrichment",
            "pages": [
              "ems/receipts",
              "ems/receipt-scanner",
              "ems/environmental-impact"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "ems/plugins"
            ]
          },
          {
            "group": "API — Auth",
            "pages": ["api-reference/ems/authentication"],
            "openapi": {
              "source": "openapi/oauth.json",
              "directory": "api-reference/ems/oauth"
            }
          },
          {
            "group": "API — Endpoints",
            "pages": ["api-reference/ems/overview"],
            "openapi": {
              "source": "openapi/ems-api.json",
              "directory": "api-reference/ems"
            }
          }
        ]
      },
      {
        "tab": "Card Issuers",
        "groups": [
          {
            "group": "Digital receipts",
            "pages": [
              "card-issuers/index",
              "card-issuers/digital-receipts"
            ]
          },
          {
            "group": "API",
            "pages": ["api-reference/receipts/overview"],
            "openapi": {
              "source": "openapi/receipts-api.json",
              "directory": "api-reference/receipts"
            }
          }
        ]
      },
      {
        "tab": "Receipt Providers",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "receipt-providers/index",
              "receipt-providers/how-it-works"
            ]
          },
          {
            "group": "Deliver receipts",
            "pages": [
              "receipt-providers/callback-delivery",
              "receipt-providers/payload-formats"
            ]
          }
        ]
      }
    ]
  }
}
